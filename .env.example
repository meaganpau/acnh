# Copy this file to .env and fill in MONGODB_URI. .env is gitignored.

# Port for the Express API server. package.json's "proxy" points at this port,
# and the React dev server is pinned to 3100 by the "start" script.
PORT=8000

# MongoDB connection string. Pick one:
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/acnh
# MongoDB Atlas
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/acnh
